# Copy to .env and replace LM_STUDIO_MODEL with the exact local model ID.
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=your_model_name

# Local persisted indexes
CHROMA_PATH=./storage/chroma
BM25_INDEX_PATH=./storage/bm25_index.pkl
CHROMA_COLLECTION_NAME=iiitdm_docs

# Keep these the same as the settings used to build the existing indexes.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=125

# Retrieval and evidence checks
DENSE_TOP_K=20
BM25_TOP_K=20
HYBRID_TOP_K=20
RERANK_TOP_K=5
RRF_K=60
EVIDENCE_SCORE_THRESHOLD=0.5
EVIDENCE_MIN_CHUNKS=2
MAX_QUERY_REFORMULATION_RETRIES=1
