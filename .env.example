# =============================================================
# IIITDM Knowledge RAG - Environment Configuration
# =============================================================
#
# Copy this file to ".env":
#
#     copy .env.example .env
#
# Then update LM_STUDIO_MODEL if required.
#
# IMPORTANT:
# This project uses only local models.
# No OpenAI, Gemini, or Anthropic API key is required.
#
# =============================================================


# =============================================================
# LM STUDIO - LOCAL LLM
# =============================================================
#
# Start LM Studio:
#
# 1. Open LM Studio.
# 2. Load your chat/instruct model.
# 3. Open Developer -> Local Server.
# 4. Start the server.
#
# LM Studio exposes an OpenAI-compatible API locally.
#

LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1


# -------------------------------------------------------------
# LM Studio model
# -------------------------------------------------------------
#
# Use the exact model ID shown by LM Studio's local server.
#
# Your currently selected model:
#

LM_STUDIO_MODEL=llmqwen3.5-2b-claude-4.6-opus-reasoning-distilled@q3_k_l


# =============================================================
# VECTOR AND RETRIEVAL STORAGE
# =============================================================

# Persistent Chroma vector database.
CHROMA_PATH=./storage/chroma


# Persisted BM25 lexical index.
#
# Generate it using:
#
#     python scripts/rebuild_index.py
#
BM25_INDEX_PATH=./storage/bm25_index.pkl


# =============================================================
# LOCAL MODELS
# =============================================================

# Embedding model used for dense semantic retrieval.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5


# Cross-encoder used after hybrid retrieval.
#
# Pipeline:
#
# Dense + BM25
#        ↓
# RRF Fusion
#        ↓
# Top 20
#        ↓
# Cross Encoder
#        ↓
# Top 5
#
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2


# =============================================================
# DOCUMENT CHUNKING
# =============================================================

# Approximate maximum chunk size in characters.
CHUNK_SIZE=900


# Number of overlapping characters between chunks.
CHUNK_OVERLAP=125


# =============================================================
# RETRIEVAL CONFIGURATION
# =============================================================

# Number of documents retrieved by dense/vector search.
DENSE_TOP_K=20


# Number of documents retrieved by BM25 lexical search.
BM25_TOP_K=20


# Number of unique candidates kept after RRF fusion.
HYBRID_TOP_K=20


# Number of candidates kept after cross-encoder reranking.
RERANK_TOP_K=5


# =============================================================
# RECIPROCAL RANK FUSION
# =============================================================
#
# RRF score:
#
#     score(d) =
#         Σ 1 / (RRF_K + rank)
#
# Typical value:
#
#     60
#
RRF_K=60


# =============================================================
# OPTIONAL DENSE / BM25 WEIGHT
# =============================================================
#
# IMPORTANT:
#
# This is NOT used if hybrid_retrieval.py uses pure RRF.
#
# Keep it here only if your implementation optionally supports
# weighted score fusion.
#
# 1.0 = Dense only
# 0.0 = BM25 only
# 0.5 = Equal contribution
#
DENSE_WEIGHT=0.5


# =============================================================
# EVIDENCE SUFFICIENCY GATE
# =============================================================
#
# After reranking, the pipeline checks whether enough evidence
# exists before sending context to the LLM.
#
# A chunk qualifies when:
#
#     relevance_score >= EVIDENCE_SCORE_THRESHOLD
#
EVIDENCE_SCORE_THRESHOLD=0.5


# Minimum number of qualifying chunks required.
#
# Example:
#
# Threshold = 0.5
# Minimum chunks = 2
#
# At least two reranked chunks must have a relevance score >= 0.5.
#
EVIDENCE_MIN_CHUNKS=2


# =============================================================
# QUERY REFORMULATION
# =============================================================
#
# If the evidence gate returns INSUFFICIENT:
#
# Original Query
#       ↓
# Retrieval
#       ↓
# Reranking
#       ↓
# Evidence Gate
#       ↓
# INSUFFICIENT
#       ↓
# Query Reformulation
#       ↓
# Retrieval Again
#
# Maximum number of retries.
#
# 0 = Disable reformulation
# 1 = Retry once
#
MAX_QUERY_REFORMULATION_RETRIES=1


# =============================================================
# LANGSMITH OBSERVABILITY
# =============================================================
#
# LangSmith is completely optional.
#
# The pipeline must work when this is false.
#
LANGSMITH_TRACING=false


# Required only when LANGSMITH_TRACING=true.
#
# Leave empty when tracing is disabled.
#
LANGSMITH_API_KEY=


# LangSmith project name.
LANGSMITH_PROJECT=iiitdm-knowledge-rag


# =============================================================
# IMPORTANT NOTES
# =============================================================
#
# This project does NOT require:
#
# OPENAI_API_KEY
# GEMINI_API_KEY
# ANTHROPIC_API_KEY
#
# All generation happens locally through LM Studio.
#
# The "openai" Python package is used ONLY as an HTTP client
# for LM Studio's OpenAI-compatible local API.
#
# =============================================================